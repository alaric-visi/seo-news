---
import Calendar from '../components/Calendar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadNews } from '../lib/query';

const data = await loadNews();
const counts = new Map(data.days.map((d) => [d, data.byDay.get(d)!.length]));

// Every month from the newest day back to the oldest, including empty ones.
const months: string[] = [];
if (data.days.length) {
  const newest = data.days[0].slice(0, 7);
  const oldest = data.days[data.days.length - 1].slice(0, 7);
  let [y, m] = newest.split('-').map(Number);
  for (let key = newest; key >= oldest; ) {
    months.push(key);
    m -= 1;
    if (m === 0) { m = 12; y -= 1; }
    key = `${y}-${String(m).padStart(2, '0')}`;
  }
}
---

<BaseLayout
  title="SEO News Archive: Every Day in SEO by Month | Mike Higgins"
  description="Browse the SEO News archive by day. Each date links to that day's Google announcements, algorithm update rollouts and search industry coverage."
  section="archive"
  ogSlug="archive"
>
  <section class="panel flex-1" aria-labelledby="archive-heading">
    <div class="panel-header">
      <div class="panel-title-wrap">
        <p class="panel-title">Archive</p>
        <span class="panel-meta">{data.stories.length} stories · {data.days.length} days</span>
      </div>
    </div>
    <div class="panel-body">
      <h1 id="archive-heading" class="text-2xl font-semibold tracking-[-0.02em] text-white sm:text-[28px]">SEO News archive</h1>
      <p class="mt-1 text-[13px] text-muted-foreground">Pick a day to see its stories. Brighter days had more news.</p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {months.map((m) => <Calendar month={m} counts={counts} today={data.today} id={`m-${m}`} />)}
      </div>
    </div>
  </section>
</BaseLayout>
