---
import type { GetStaticPaths } from 'astro';
import StoryCard from '../../components/StoryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagById } from '../../config/tags';
import { formatDayLong } from '../../lib/dates';
import { dayHref } from '../../lib/paths';
import { activeTags, loadNews } from '../../lib/query';
import { collectionJsonLd } from '../../lib/seo';

const MAX_STORIES = 300;

export const getStaticPaths = (async () => {
  const data = await loadNews();
  return activeTags(data).map((t) => ({ params: { tag: t.id } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const rule = tagById(tag)!;
const data = await loadNews();
const stories = data.stories.filter((s) => s.tags.includes(tag)).slice(0, MAX_STORIES);
const byDay = new Map<string, typeof stories>();
for (const s of stories) byDay.set(s.day, [...(byDay.get(s.day) ?? []), s]);

const title = `${rule.label} News: Latest SEO Updates | Mike Higgins`;
const description = rule.intro.length > 160 ? `${rule.intro.slice(0, 157).replace(/\s+\S*$/, '')}…` : rule.intro;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={collectionJsonLd({ name: `${rule.label} news`, description: rule.intro, url: new URL(Astro.url.pathname, Astro.site).toString(), stories })}
>
  <header class="mb-8 max-w-3xl">
    <p class="text-section-label uppercase text-primary">SEO News · Topic</p>
    <h1 class="mt-3 font-display text-3xl font-light tracking-tight sm:text-4xl">{rule.label}</h1>
    <p class="mt-3 leading-relaxed text-muted-foreground">{rule.intro}</p>
    <p class="mt-2 font-mono text-xs text-muted-foreground">{data.tagCounts.get(tag)} stories{stories.length < (data.tagCounts.get(tag) ?? 0) && `, latest ${stories.length} shown`}</p>
  </header>

  <div class="max-w-3xl space-y-10">
    {[...byDay.entries()].map(([day, list]) => (
      <section aria-labelledby={`d-${day}`}>
        <h2 id={`d-${day}`} class="mb-3 font-display text-sm font-medium text-muted-foreground">
          <a href={dayHref(day)} class="hover:text-foreground">{formatDayLong(day)}</a>
        </h2>
        <ul class="space-y-3">
          {list.map((s) => <li class="list-none"><StoryCard story={s} /></li>)}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
