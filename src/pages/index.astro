---
import DayView from '../components/DayView.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeEdition, loadNews } from '../lib/query';
import { collectionJsonLd } from '../lib/seo';

const data = await loadNews();
const { day, soFarToday } = homeEdition(data);
const title = 'SEO News Today: Every Day in SEO, on One Calendar | Mike Higgins';
const description =
  "Today's SEO news in one place: Google's own announcements, core and spam update rollouts from the Search Status Dashboard, and coverage from the search trade press, tool vendors and Hacker News.";
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={day ? collectionJsonLd({ name: 'SEO News', description, url: new URL(Astro.url.pathname, Astro.site).toString(), stories: data.byDay.get(day) ?? [] }) : undefined}
>
  {day ? (
    <DayView data={data} day={day} isHome soFarToday={soFarToday} />
  ) : (
    <div class="mx-auto max-w-xl py-16 text-center">
      <h1 class="font-display text-3xl font-light">SEO News</h1>
      <p class="mt-4 text-muted-foreground">No stories yet. Run <code class="font-mono text-foreground">npm run news:fetch</code> and rebuild.</p>
    </div>
  )}
</BaseLayout>
