---
import '@fontsource-variable/inter';
import '@fontsource-variable/geist';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import AboutDialog from '../components/AboutDialog.astro';
import SiteNav from '../components/SiteNav.astro';
import { formatDayShort, formatTime, londonDay } from '../lib/dates';
import { archiveHref, href, rssHref } from '../lib/paths';
import { loadNews, openIncidents } from '../lib/query';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  /** Which segment of the view switcher is current. */
  section?: 'today' | 'archive' | null;
}

const { title, description, jsonLd, section = null } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Pages are indexable. SEO_NEWS_NOINDEX=true adds noindex everywhere (e.g. a staging deploy).
// Astro turns "true" in env vars into a boolean, so compare as strings.
const indexable = String(import.meta.env.SEO_NEWS_NOINDEX) !== 'true';
const gaId = import.meta.env.PUBLIC_GA_ID;

const data = await loadNews();
const rolling = openIncidents(data).filter((i) => i.serviceName === 'Ranking');
const builtAt = new Date().toISOString();
---

<!doctype html>
<html lang="en-GB">
  <head>
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/png" href={href('favicon.png')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="SEO News, Mike Higgins" href={rssHref()} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SEO News, Mike Higgins" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@mikejhiggins" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground">Skip to content</a>
    <SiteNav />

    <header class="app-header">
      <div class="header-left">
        <a href="https://mikehiggins.me.uk/tools/" class="back-link" title="Back to Tools" aria-label="Back to Tools">
          <span aria-hidden="true">&larr;</span>
          <span class="back-link-text">Back to Tools</span>
        </a>
        <div class="title-group">
          <a href={href()} class="app-title">
            <svg class="icon text-teal" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="17" rx="2" /><path d="M3 9h18M8 2v4M16 2v4" /><path d="M7 13h4M7 17h7" />
            </svg>
            SEO News
          </a>
          <span class="app-subtitle">Every day in SEO, on one calendar</span>
        </div>
        <div class="header-divider" aria-hidden="true"></div>
        <div class="header-metrics">
          <span class="header-pill">{data.stories.length} stories</span>
          <span aria-hidden="true">&middot;</span>
          <span class="header-pill">{data.days.length} days</span>
          {rolling.map((i) => (
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="header-pill live" title={`Rolling out since ${formatDayShort(londonDay(i.beginAt))}`}>{i.title} rolling out</span>
            </>
          ))}
        </div>
      </div>

      <nav aria-label="SEO News views" class="segmented-control">
        <a href={href()} class="segment-btn" aria-current={section === 'today' ? 'page' : undefined}>Today</a>
        <a href={archiveHref()} class="segment-btn" aria-current={section === 'archive' ? 'page' : undefined}>Archive</a>
      </nav>

      <div class="header-right">
        <a href={rssHref()} class="btn" title="Subscribe with RSS" aria-label="RSS feed">
          <svg class="icon-sm text-teal" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
          <span class="btn-text-wide">RSS</span>
        </a>
        <button type="button" class="btn" id="btn-about" aria-haspopup="dialog" title="About SEO News" aria-label="About SEO News">
          <svg class="icon-sm text-teal" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
          <span class="btn-text-wide">About</span>
        </button>
      </div>
    </header>

    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>

    <footer class="status-bar">
      <span class="status-badge"><span class="status-badge-dot" aria-hidden="true"></span>Updated <time datetime={builtAt}>{formatDayShort(londonDay(builtAt))}, {formatTime(builtAt)}</time> UK · daily at about 05:15 UTC</span>
      <span>Headlines link to the original publishers · AI summaries from headlines and feed descriptions only</span>
    </footer>

    <AboutDialog />
  </body>
</html>

<script>
  const about = document.getElementById('about-dialog') as HTMLDialogElement | null;
  const open = () => { if (about && !about.open) about.showModal(); };
  document.getElementById('btn-about')?.addEventListener('click', open);
  document.getElementById('btn-close-about')?.addEventListener('click', () => about?.close());
  about?.addEventListener('click', (e) => { if (e.target === about) about.close(); });
  about?.addEventListener('close', () => {
    if (location.hash === '#about') history.replaceState(null, '', location.pathname + location.search);
  });
  if (location.hash === '#about') open();
</script>
