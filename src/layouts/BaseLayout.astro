---
import '@fontsource-variable/inter';
import '@fontsource-variable/geist';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import AboutDialog from '../components/AboutDialog.astro';
import { formatDayShort, formatTime, londonDay } from '../lib/dates';
import { archiveHref, href, rssHref } from '../lib/paths';
import { loadNews, openIncidents } from '../lib/query';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  /** Which segment of the view switcher is current. */
  section?: 'today' | 'archive' | null;
  /** Open Graph image slug under /og/ (see src/pages/og/[...slug].png.ts). */
  ogSlug?: string;
  /** Alt text for the Open Graph image. */
  ogAlt?: string;
  /** og:type: 'website' for the home page, 'article' for dated pages. */
  ogType?: 'website' | 'article';
  /** ISO date for article:published_time on day pages. */
  publishedTime?: string;
}

const { title, description, jsonLd, section = null, ogSlug = 'home', ogAlt, ogType = 'website', publishedTime } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(href(`og/${ogSlug}.png`), Astro.site).toString();
const imageAlt = ogAlt ?? `SEO News: ${title}`;
const logoUrl = new URL(href('icon-512.png'), Astro.site).toString();
// Site-wide identity, merged into each page's JSON-LD.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${Astro.site}#website`,
  name: 'SEO News',
  alternateName: 'Every day in SEO, on one calendar',
  url: Astro.site?.toString(),
  inLanguage: 'en-GB',
  image: logoUrl,
  publisher: {
    '@type': 'Person',
    name: 'Mike Higgins',
    url: 'https://mikehiggins.me.uk/',
    image: logoUrl,
  },
};
// Pages are indexable. SEO_NEWS_NOINDEX=true adds noindex everywhere (e.g. a staging deploy).
// Astro turns "true" in env vars into a boolean, so compare as strings.
const indexable = String(import.meta.env.SEO_NEWS_NOINDEX) !== 'true';
const gaId = import.meta.env.PUBLIC_GA_ID;

const data = await loadNews();
const rolling = openIncidents(data).filter((i) => i.serviceName === 'Ranking');
const builtAt = new Date().toISOString();
---

<!doctype html>
<html lang="en-GB">
  <head>
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={href('favicon.png')} />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <link rel="manifest" href={href('site.webmanifest')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="SEO News, Mike Higgins" href={rssHref()} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="SEO News" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content="https://mikehiggins.me.uk/" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mikejhiggins" />
    <meta name="twitter:creator" content="@mikejhiggins" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify({ ...jsonLd, image: ogImage })} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground">Skip to content</a>

    <header class="app-header">
      <div class="header-left">
        <a href="https://mikehiggins.me.uk/" class="back-link" title="mikehiggins.me.uk" aria-label="mikehiggins.me.uk">
          <span aria-hidden="true">&larr;</span>
          <span class="back-link-text">mikehiggins.me.uk</span>
        </a>
        <div class="title-group">
          <a href={href()} class="app-title">
            <img src={href('logo.svg')} alt="" width="22" height="22" class="h-[22px] w-[22px]" />
            SEO News
          </a>
          <span class="app-subtitle">Every day in SEO, on one calendar</span>
        </div>
        <div class="header-divider" aria-hidden="true"></div>
        <div class="header-metrics">
          <span class="header-pill">{data.stories.length} stories</span>
          <span aria-hidden="true">&middot;</span>
          <span class="header-pill">{data.days.length} days</span>
          {rolling.map((i) => (
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="header-pill live" title={`Rolling out since ${formatDayShort(londonDay(i.beginAt))}`}>{i.title} rolling out</span>
            </>
          ))}
        </div>
      </div>

      <nav aria-label="SEO News views" class="segmented-control">
        <a href={href()} class="segment-btn" aria-current={section === 'today' ? 'page' : undefined}>Today</a>
        <a href={archiveHref()} class="segment-btn" aria-current={section === 'archive' ? 'page' : undefined}>Archive</a>
      </nav>

      <div class="header-right">
        <a href={rssHref()} class="btn" title="Subscribe with RSS" aria-label="RSS feed">
          <svg class="icon-sm text-teal" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
          <span class="btn-text-wide">RSS</span>
        </a>
        <button type="button" class="btn" id="btn-about" aria-haspopup="dialog" title="About SEO News" aria-label="About SEO News">
          <svg class="icon-sm text-teal" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
          <span class="btn-text-wide">About</span>
        </button>
      </div>
    </header>

    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>

    <footer class="status-bar">
      <span class="status-badge"><span class="status-badge-dot" aria-hidden="true"></span>Updated <time datetime={builtAt}>{formatDayShort(londonDay(builtAt))}, {formatTime(builtAt)}</time> UK · daily at about 05:15 UTC</span>
      <span>Headlines link to the original publishers · AI summaries from headlines and feed descriptions only</span>
    </footer>

    <AboutDialog />
  </body>
</html>

<script>
  const about = document.getElementById('about-dialog') as HTMLDialogElement | null;
  const open = () => { if (about && !about.open) about.showModal(); };
  document.getElementById('btn-about')?.addEventListener('click', open);
  document.getElementById('btn-close-about')?.addEventListener('click', () => about?.close());
  about?.addEventListener('click', (e) => { if (e.target === about) about.close(); });
  about?.addEventListener('close', () => {
    if (location.hash === '#about') history.replaceState(null, '', location.pathname + location.search);
  });
  if (location.hash === '#about') open();
</script>
