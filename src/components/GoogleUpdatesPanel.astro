---
import { daysBetween, formatDayShort, londonDay } from '../lib/dates';
import type { NewsData } from '../lib/query';

interface Props { data: NewsData }
const { data } = Astro.props;

/** Ranking updates usually say "may take up to 2 weeks"; read the figure if present. */
function rolloutWindowDays(updates: { text: string }[]): number | null {
  for (const u of updates) {
    const m = /up to (\d+|one|two|three|four) (day|week)s?/i.exec(u.text);
    if (!m) continue;
    const n = { one: 1, two: 2, three: 3, four: 4 }[m[1].toLowerCase()] ?? Number(m[1]);
    return m[2].toLowerCase() === 'week' ? n * 7 : n;
  }
  return null;
}

const open = data.incidents.filter((i) => !i.endAt);
const recent = data.incidents.filter((i) => i.endAt).slice(0, 6);
---

<section aria-labelledby="google-updates-heading" class="rounded-lg border bg-card">
  <div class="flex items-center justify-between border-b px-4 py-3">
    <h2 id="google-updates-heading" class="font-display text-sm font-medium">Google updates</h2>
    <a href="https://status.search.google.com/" rel="noopener" target="_blank" class="text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Status Dashboard</a>
  </div>

  {data.incidents.length === 0 ? (
    <p class="px-4 py-4 text-sm text-muted-foreground">No incidents recorded yet.</p>
  ) : (
    <div class="divide-y">
      {open.map((i) => {
        const day = daysBetween(londonDay(i.beginAt), data.today) + 1;
        const window = rolloutWindowDays(i.updates);
        const isRanking = i.serviceName === 'Ranking';
        return (
          <a href={i.uri} rel="noopener" target="_blank" class="block px-4 py-3 transition-colors hover:bg-secondary">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:animate-none"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
              </span>
              <span class="text-[10px] font-medium uppercase tracking-wider text-accent">{isRanking ? 'Rolling out' : 'Ongoing'}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-foreground">{i.title}</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
              Started {formatDayShort(londonDay(i.beginAt))} · day {day}{window ? ` of up to ${window}` : ''}
            </p>
            {window && (
              <div class="mt-2 h-1 overflow-hidden rounded-full bg-muted" role="presentation">
                <div class="h-full rounded-full bg-accent" style={`width:${Math.min(100, Math.round((day / window) * 100))}%`}></div>
              </div>
            )}
          </a>
        );
      })}

      {recent.length > 0 && (
        <div class="px-4 py-3">
          <p class="text-section-label uppercase text-muted-foreground">Recently completed</p>
          <ul class="mt-2 space-y-2">
            {recent.map((i) => {
              const start = londonDay(i.beginAt);
              const end = londonDay(i.endAt!);
              const length = daysBetween(start, end) + 1;
              return (
                <li>
                  <a href={i.uri} rel="noopener" target="_blank" class="group block">
                    <span class="text-sm text-foreground/90 group-hover:text-foreground">{i.title}</span>
                    <span class="block font-mono text-[11px] text-muted-foreground">
                      {i.serviceName && i.serviceName !== 'Ranking' && `${i.serviceName} · `}{formatDayShort(start)}{start !== end && ` – ${formatDayShort(end)}`} · {length} {length === 1 ? 'day' : 'days'}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
  )}
</section>
