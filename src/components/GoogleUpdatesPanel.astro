---
import { daysBetween, formatDayShort, londonDay } from '../lib/dates';
import type { NewsData } from '../lib/query';

interface Props { data: NewsData }
const { data } = Astro.props;

/** Ranking updates usually say "may take up to 2 weeks"; read the figure if present. */
function rolloutWindowDays(updates: { text: string }[]): number | null {
  for (const u of updates) {
    const m = /up to (\d+|one|two|three|four) (day|week)s?/i.exec(u.text);
    if (!m) continue;
    const n = { one: 1, two: 2, three: 3, four: 4 }[m[1].toLowerCase()] ?? Number(m[1]);
    return m[2].toLowerCase() === 'week' ? n * 7 : n;
  }
  return null;
}

const open = data.incidents.filter((i) => !i.endAt);
const recent = data.incidents.filter((i) => i.endAt).slice(0, 6);
---

<section aria-labelledby="google-updates-heading" class="side-section">
  <div class="panel-header">
    <div class="panel-title-wrap">
      <h2 id="google-updates-heading" class="panel-title">Google updates</h2>
      {open.length > 0 && <span class="panel-meta">{open.length} active</span>}
    </div>
    <a href="https://status.search.google.com/" rel="noopener" target="_blank" class="btn btn-xs" title="Google Search Status Dashboard">Dashboard</a>
  </div>

  {data.incidents.length === 0 ? (
    <p class="px-4 py-4 text-muted-foreground">No incidents recorded yet.</p>
  ) : (
    <div class="space-y-3 p-4">
      {open.map((i) => {
        const day = daysBetween(londonDay(i.beginAt), data.today) + 1;
        const window = rolloutWindowDays(i.updates);
        const isRanking = i.serviceName === 'Ranking';
        return (
          <a href={i.uri} rel="noopener" target="_blank" class="info-card block transition-colors hover:border-[var(--accent-hex)]">
            <span class="status-badge info-card-title">
              <span class="status-badge-dot animate-pulse motion-reduce:animate-none" aria-hidden="true"></span>
              {isRanking ? 'Rolling out' : 'Ongoing'}
            </span>
            <p class="mt-1.5 text-sm font-semibold text-foreground">{i.title}</p>
            <p class="mono mt-0.5 text-[11px] text-muted-foreground">
              Started {formatDayShort(londonDay(i.beginAt))} · day {day}{window ? ` of up to ${window}` : ''}
            </p>
            {window && (
              <div class="mt-2 h-1 overflow-hidden rounded-full bg-white/10" role="presentation">
                <div class="h-full rounded-full bg-primary shadow-[0_0_8px_var(--accent-glow)]" style={`width:${Math.min(100, Math.round((day / window) * 100))}%`}></div>
              </div>
            )}
          </a>
        );
      })}

      {recent.length > 0 && (
        <div>
          <p class="section-label mb-2">Recently completed</p>
          <ul class="space-y-2">
            {recent.map((i) => {
              const start = londonDay(i.beginAt);
              const end = londonDay(i.endAt!);
              const length = daysBetween(start, end) + 1;
              return (
                <li>
                  <a href={i.uri} rel="noopener" target="_blank" class="group block">
                    <span class="text-[13px] text-foreground/90 group-hover:text-foreground">{i.title}</span>
                    <span class="mono block text-[11px] text-[var(--text-dim)]">
                      {i.serviceName && i.serviceName !== 'Ranking' && `${i.serviceName} · `}{formatDayShort(start)}{start !== end && ` – ${formatDayShort(end)}`} · {length} {length === 1 ? 'day' : 'days'}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
  )}
</section>
