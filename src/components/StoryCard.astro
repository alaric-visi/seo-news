---
import { CATEGORY_LABELS } from '../config/sources';
import { formatDayShort, formatTime } from '../lib/dates';
import type { StoryView } from '../lib/query';
import TagChip from './TagChip.astro';

interface Props {
  story: StoryView;
  /** Show the date as well as the time (tag pages list several days). */
  showDate?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { story, showDate = false, headingLevel = 'h3' } = Astro.props;
const official = story.sourceCategory === 'official';
const Heading = headingLevel;
const discussionUrl = typeof story.extra.discussionUrl === 'string' ? story.extra.discussionUrl : null;
---

<article
  class:list={[
    'rounded-lg border bg-card p-4 sm:p-5',
    official && 'border-l-4 border-l-primary bg-primary/[0.06]',
  ]}
>
  <div class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
    {official ? (
      <span class="inline-flex items-center gap-1 rounded-sm bg-primary px-1.5 py-0.5 font-medium text-primary-foreground">
        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3 w-3" fill="currentColor"><path d="M8 0l2 5.3 5.6.3-4.4 3.6 1.5 5.4L8 11.6 3.3 14.6l1.5-5.4L.4 5.6 6 5.3z" /></svg>
        {CATEGORY_LABELS.official}
      </span>
    ) : (
      <span class="uppercase tracking-wider text-[10px] text-muted-foreground">{CATEGORY_LABELS[story.sourceCategory]}</span>
    )}
    <span class="font-medium text-foreground/90">{story.sourceName}</span>
    <span class="text-muted-foreground" aria-hidden="true">·</span>
    <time datetime={story.publishedAt} class="font-mono text-muted-foreground">
      {showDate && `${formatDayShort(story.day)}, `}{formatTime(story.publishedAt)}
    </time>
  </div>

  <Heading class="font-display text-base font-medium leading-snug sm:text-lg">
    <a href={story.url} class="text-foreground decoration-primary/60 underline-offset-4 hover:underline" rel="noopener" target="_blank">
      {story.title}<span class="sr-only"> (opens on {story.sourceName})</span>
    </a>
  </Heading>

  {story.summary && (
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      <span class="mr-1 rounded-sm border px-1 py-px font-mono text-[10px] uppercase tracking-wider text-muted-foreground/80" title="Written by AI from the headline and feed description">AI summary</span>
      {story.summary}
    </p>
  )}

  {(story.tags.length > 0 || discussionUrl) && (
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      {story.tags.map((t) => <TagChip tag={t} />)}
      {discussionUrl && (
        <a href={discussionUrl} rel="noopener" target="_blank" class="ml-1 text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Discussion</a>
      )}
    </div>
  )}
</article>
