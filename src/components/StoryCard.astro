---
import { CATEGORY_LABELS } from '../config/sources';
import { formatDayShort, formatTime } from '../lib/dates';
import type { StoryView } from '../lib/query';
import TagChip from './TagChip.astro';

interface Props {
  story: StoryView;
  /** Show the date as well as the time (tag pages list several days). */
  showDate?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { story, showDate = false, headingLevel = 'h3' } = Astro.props;
const official = story.sourceCategory === 'official';
const Heading = headingLevel;
const discussionUrl = typeof story.extra.discussionUrl === 'string' ? story.extra.discussionUrl : null;
---

<article class:list={['card', official && 'card-official']}>
  <div class="mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11.5px]">
    {official ? (
      <span class="badge-official">
        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-2.5 w-2.5" fill="currentColor"><path d="M8 0l2 5.3 5.6.3-4.4 3.6 1.5 5.4L8 11.6 3.3 14.6l1.5-5.4L.4 5.6 6 5.3z" /></svg>
        {CATEGORY_LABELS.official}
      </span>
    ) : (
      <span class="k">{CATEGORY_LABELS[story.sourceCategory]}</span>
    )}
    <span class="font-medium text-foreground/90">{story.sourceName}</span>
    <span class="text-muted-foreground" aria-hidden="true">·</span>
    <time datetime={story.publishedAt} class="mono text-[11px] text-muted-foreground">
      {showDate && `${formatDayShort(story.day)}, `}{formatTime(story.publishedAt)}
    </time>
  </div>

  <Heading class="text-[15px] font-semibold leading-snug tracking-[-0.01em]">
    <a href={story.url} class="text-foreground decoration-primary/70 underline-offset-4 hover:underline" rel="noopener" target="_blank">
      {story.title}<span class="sr-only"> (opens on {story.sourceName})</span>
    </a>
  </Heading>

  {story.summary && (
    <p class="mt-1.5 text-[13px] leading-relaxed text-muted-foreground">
      <span class="badge-ai mr-1" title="Written by AI from the headline and feed description">AI summary</span>
      {story.summary}
    </p>
  )}

  {(story.tags.length > 0 || discussionUrl) && (
    <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
      {story.tags.map((t) => <TagChip tag={t} />)}
      {discussionUrl && (
        <a href={discussionUrl} rel="noopener" target="_blank" class="mono ml-1 text-[11px] text-accent hover:underline">Discussion →</a>
      )}
    </div>
  )}
</article>
