---
import { formatDayShort } from '../lib/dates';
import { dayHref } from '../lib/paths';
import type { StoryGroup } from '../lib/query';
import StoryCard from './StoryCard.astro';

interface Props { group: StoryGroup }
const { group } = Astro.props;
const { lead, others, elsewhere } = group;
---

<li class="list-none">
  <StoryCard story={lead} headingLevel="h3" />
  {(others.length > 0 || elsewhere.length > 0) && (
    <div class="ml-3 border-l border-[var(--accent-border)] pl-4 pt-2.5 sm:ml-4">
      {others.length > 0 && (
        <>
          <p class="section-label">Also covered by {others.length} {others.length === 1 ? 'outlet' : 'outlets'}</p>
          <ul class="mt-1.5 space-y-1">
            {others.map((s) => (
              <li class="text-[13px] leading-snug">
                <span class:list={['font-medium', s.sourceCategory === 'official' ? 'text-accent' : 'text-foreground/85']}>{s.sourceName}:</span>{' '}
                <a href={s.url} rel="noopener" target="_blank" class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{s.title}</a>
              </li>
            ))}
          </ul>
        </>
      )}
      {elsewhere.length > 0 && (
        <p class:list={['mono text-[11px] text-[var(--text-dim)]', others.length > 0 && 'mt-2']}>
          Same story on other days:{' '}
          {elsewhere.slice(0, 4).map((s, i) => (
            <>
              {i > 0 && ', '}
              <a href={dayHref(s.day)} class="text-accent hover:underline">{formatDayShort(s.day)} ({s.sourceName})</a>
            </>
          ))}
          {elsewhere.length > 4 && ` and ${elsewhere.length - 4} more`}
        </p>
      )}
    </div>
  )}
</li>
