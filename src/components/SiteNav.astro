---
/** Static copy of the portfolio's top navigation (portfolio/src/components/Navigation.tsx). */
const items = [
  { url: 'https://mikehiggins.me.uk/', label: 'Home' },
  { url: 'https://mikehiggins.me.uk/about/', label: 'About' },
  { url: 'https://mikehiggins.me.uk/tools/', label: 'Tools', current: true },
  { url: 'https://mikehiggins.me.uk/blog/', label: 'Blog' },
];
const logo = 'M13.73 4a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z';
---

<nav class="site-nav" aria-label="Mike Higgins">
  <div class="site-nav-inner">
    <a href="https://mikehiggins.me.uk/" aria-label="Mike Higgins, home" class="p-1">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-foreground" aria-hidden="true"><path d={logo} /></svg>
    </a>
    <div class="site-nav-links">
      {items.map((i) => (
        <a href={i.url} class="site-nav-link" aria-current={i.current ? 'page' : undefined}>{i.label}</a>
      ))}
    </div>
    <details class="site-nav-menu">
      <summary aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="18" y2="18" /></svg>
      </summary>
      <div class="site-nav-panel">
        {items.map((i) => (
          <a href={i.url} aria-current={i.current ? 'page' : undefined}>{i.label}</a>
        ))}
      </div>
    </details>
  </div>
</nav>
