{
  "name": "seo-news",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Every day in SEO, on one calendar. Daily SEO news aggregator at seo-news.mikehiggins.me.uk.",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "news:fetch": "tsx scripts/fetch.ts",
    "news:summarise": "tsx scripts/summarise.ts",
    "news:all": "tsx scripts/fetch.ts && tsx scripts/summarise.ts",
    "brand": "tsx scripts/brand.mts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.95.3",
    "astro": "^5.18.2",
    "fast-xml-parser": "^5.2.5",
    "satori": "^0.12.2",
    "tailwindcss": "^3.4.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  }
}
