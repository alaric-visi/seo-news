# Copy to .env for local runs. In GitHub Actions these are repository secrets;
# on Netlify only the PUBLIC/read-only values are needed.

# --- Supabase (project: seo-news) ---
SUPABASE_URL=https://xayayfpwxnmtrlojjcua.supabase.co
# Read-only key, used by the site build (Project Settings -> API Keys -> publishable, or legacy "anon").
SUPABASE_PUBLISHABLE_KEY=
# Write key, used only by the fetch/summarise scripts. Never add this to Netlify.
# (Project Settings -> API Keys -> secret, or legacy "service_role").
SUPABASE_SECRET_KEY=

# Where stories are stored: "supabase", or "local" for a JSON file in .data/ (no account needed).
# Defaults to supabase when the keys above are set, otherwise local.
NEWS_STORE=

# --- DeepSeek (AI summaries) ---
DEEPSEEK_API_KEY=
# deepseek-flash (default, cheapest) or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# --- Site ---
# Set to true to add noindex to every page (e.g. on a staging deploy). Unset = indexable.
SEO_NEWS_NOINDEX=
# Google Analytics ID, e.g. G-RV46FH6BMG. Unset = no analytics tag.
PUBLIC_GA_ID=
